# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=us-central1

# Agent Registry location (us-central1 matches where MCP servers are deployed)
AGENT_REGISTRY_LOCATION=us-central1

# Deployment Configuration
# Set this to your Agent Engine ID after the first deployment to perform in-place updates
AGENT_ENGINE_ID=projects/your-project-number/locations/us-central1/reasoningEngines/your-engine-id

# Force ADK to use Vertex AI instead of AI Studio
GOOGLE_GENAI_USE_VERTEXAI=true

# Prevent SDK from switching to mTLS endpoint when AGENT_IDENTITY is set.
GOOGLE_API_USE_MTLS_ENDPOINT=never

# Telemetry - populates Agent Engine observability dashboard and traces
# See: https://cloud.google.com/vertex-ai/generative-ai/docs/agent-engine/observability
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Agent Gateway (Agent-to-Anywhere egress)
# Set to the gateway name after creating it in Cloud Console.
# WARNING: binding is permanent and cannot be undone.
AGENT_GATEWAY_NAME=your-agent-gateway-name
STAGING_BUCKET=gs://your-project-id-bucket

# Agent Registry enforcement
# Set to true only after confirming the WIF principal has agentregistry.viewer IAM.
# When false (default), agents fall back to MCP URLs from env vars if registry fails.
ENFORCE_MCP_REGISTRY=false

# Required for Agent Identity to authenticate to GCP services (e.g. Agent Registry)
GOOGLE_API_PREVENT_AGENT_TOKEN_SHARING_FOR_GCP_SERVICES=false

# MCP Server URLs (Cloud Run)
# Set these after running deploy_mcp.sh, then redeploy the agent with deploy_agent.sh
# Leave empty to use local MCP servers (127.0.0.1:3001-3003) when running locally
KNOWLEDGE_MCP_URL=https://rfp-mcp-knowledge-xxxx-uc.a.run.app/mcp
POLICY_MCP_URL=https://rfp-mcp-policy-xxxx-uc.a.run.app/mcp
