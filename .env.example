# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=us-central1

# Deployment Configuration
# Set this to your Agent Engine ID after the first deployment to perform in-place updates
AGENT_ENGINE_ID=projects/your-project-number/locations/us-central1/reasoningEngines/your-engine-id

# Force ADK to use Vertex AI instead of AI Studio
GOOGLE_GENAI_USE_VERTEXAI=true

# MCP Server URLs (Cloud Run)
# Set these after running deploy_mcp.sh, then redeploy the agent with deploy_agent.sh
# Leave empty to use local MCP servers (127.0.0.1:3001-3003) when running locally
KNOWLEDGE_MCP_URL=https://rfp-mcp-knowledge-xxxx-uc.a.run.app/mcp
POLICY_MCP_URL=https://rfp-mcp-policy-xxxx-uc.a.run.app/mcp
WORKSPACE_MCP_URL=https://rfp-mcp-workspace-xxxx-uc.a.run.app/mcp
