      "inputSchema": {
        "type": "object",
        "properties": {
          "section_id": {
            "title": "Section Id",
            "type": "string"
          },
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": ["section_id", "content"]
      },
      "annotations": {
        "title": "Save Draft",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_draft",
      "description": "Retrieve a previously saved draft section from the workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section_id": {
            "title": "Section Id",
            "type": "string"
          }
        },
        "required": ["section_id"]
      },
      "annotations": {
        "title": "Get Draft",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "log_event",
      "description": "Log a workflow event to the workspace audit trail.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": ["event_type", "summary"]
      },
      "annotations": {
        "title": "Log Event",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
